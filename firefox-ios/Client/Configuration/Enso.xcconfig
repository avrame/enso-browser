// Ensō's own build. The inherited Fennec configuration is Mozilla's developer
// channel: it signs manually against Mozilla's team and claims Mozilla's
// bundle identifier, neither of which anyone outside Mozilla can provision, so
// Xcode refuses to build it here. This one carries our own identity and lets
// Xcode pick the signing certificate.

#include "Common.xcconfig"
#include "Debug.xcconfig"
#include "version.xcconfig"

INFOPLIST_FILE = Client/Info.plist

// Ensō's own version, overriding the Firefox one that version.xcconfig
// carries. Set here rather than there so upstream can keep bumping that file
// without conflicting every sync. The version sites are told about is separate
// and stays Firefox's - see UserAgent.firefoxCompatVersion.
APP_VERSION = 1.0

// The build number, which App Store Connect requires to be higher than every
// build already uploaded for this version. Bump it for each upload; the
// Info.plists all read it, so app and extensions stay in step - they are
// rejected if they disagree.
CURRENT_PROJECT_VERSION = 3

// The Enso configurations were cloned from Debug, which emits DWARF without a
// dSYM. Uploads then warn that symbols are missing, and the crash reports
// Apple collects arrive as raw addresses - which, since Ensō has no crash
// reporting of its own, would be the only crash information there is.
DEBUG_INFORMATION_FORMAT = dwarf-with-dsym

// The app group and the keychain access group are both derived from this at
// runtime, in AppInfo, so this line is the one that has to change - see
// EnsoApplication.entitlements, which has to agree with it.
MOZ_BUNDLE_ID = app.enso.browser
MOZ_BUNDLE_DISPLAY_NAME = Ensō
MOZ_TODAY_WIDGET_SEARCH_DISPLAY_NAME = Ensō - Search

// Ours, not Firefox's: two apps cannot both answer firefox://.
MOZ_PUBLIC_URL_SCHEME = enso
MOZ_INTERNAL_URL_SCHEME = enso

CODE_SIGN_ENTITLEMENTS = Client/Entitlements/EnsoApplication.entitlements

// Automatic, with no team written down: Xcode asks once in Signing &
// Capabilities and records whichever team the developer actually has.
// No CODE_SIGN_IDENTITY here on purpose. Automatic signing picks Apple
// Development for a build and Apple Distribution for an archive; pinning it to
// Development makes Xcode hunt for a development profile while archiving, and
// fail.
CODE_SIGN_STYLE = Automatic
DEVELOPMENT_TEAM =

// iPhone only. The spaces sheet and the toolbar were designed for a phone and
// have never been looked at on a tablet, and shipping a stretched phone layout
// into an iPad review is a worse outcome than not claiming iPad at all. Adding
// it back is a deliberate piece of work, not a build setting.
TARGETED_DEVICE_FAMILY = 1

INCLUDE_SETTINGS_BUNDLE = YES
CHANNEL = developer
OTHER_SWIFT_FLAGS = $(OTHER_SWIFT_FLAGS_common) -DMOZ_CHANNEL_$(CHANNEL)
OTHER_LDFLAGS = -ObjC -fprofile-instr-generate -Xlinker -no_application_extension
SWIFT_OPTIMIZATION_LEVEL = -Onone
ENABLE_NS_ASSERTIONS = YES
